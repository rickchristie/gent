# Real provider tests. Fill these values in .env; do not replace an existing .env file.
# Tests read exported variables, not .env automatically. In Bash, load your trusted file with:
#   set -a
#   source .env
#   set +a
#   go test ./models -run '^TestLive(Providers|Images)$' -count=1 -timeout 300s
# Configured providers run in normal go test runs and can incur API charges.
# Leave all settings for an unavailable provider empty. Partial settings fail the test.
# Set this to 1 to fail on every missing provider, including the four image models:
GENT_LIVE_REQUIRE_ALL=0

# Cloud _KEY values are required. _URL overrides are optional; blank uses the public API.
# _MODEL overrides are optional except for OpenRouter. Defaults are listed below.
# _IMAGE_MODEL enables real image generation. Use a model supported by that native API.
# All four _IMAGE_MODEL values are required when GENT_LIVE_REQUIRE_ALL=1.
# Details, billing links, server setup, and test limits: docs/models-live.md

# OpenAI: https://platform.openai.com/api-keys
# Add credits: https://platform.openai.com/settings/organization/billing/overview
# 1. Sign in and select the API organization that owns your key.
# 2. Open the billing link, add payment details if required, and purchase API credits.
# 3. Confirm that the balance is available, then create a key in the same organization.
# Default model: gpt-5.4-mini. Image model: a Responses model with the image_generation tool.
GENT_TEST_OPENAI_KEY=
GENT_TEST_OPENAI_MODEL=
GENT_TEST_OPENAI_IMAGE_MODEL=
GENT_TEST_OPENAI_URL=

# Anthropic: https://platform.claude.com/settings/keys
# Buy credits: https://platform.claude.com/settings/billing
# 1. Sign in to the Claude Console and select the organization that owns your key.
# 2. Open the billing link and select Buy credits.
# 3. Enter the amount, complete payment, and create a key in the same organization.
# Default model: claude-sonnet-4-6
GENT_TEST_ANTHROPIC_KEY=
GENT_TEST_ANTHROPIC_MODEL=
GENT_TEST_ANTHROPIC_URL=

# Gemini: https://aistudio.google.com/api-keys
# Billing guide: https://ai.google.dev/gemini-api/docs/billing
# 1. Sign in to AI Studio and find the project that owns your API key.
# 2. Select Set up billing and link an active Google Cloud billing account.
# 3. Add payment details; complete Prepay setup and add credits when prompted.
# 4. Use the API key from that project, whose billing tier should now show Paid.
# Default model: gemini-2.5-flash. Image model: a Gemini model with native image output.
GENT_TEST_GEMINI_KEY=
GENT_TEST_GEMINI_MODEL=
GENT_TEST_GEMINI_IMAGE_MODEL=
GENT_TEST_GEMINI_URL=

# xAI: https://console.x.ai/ (API keys)
# Buy credits: Billing > API spend management in the same console.
# Billing guide: https://docs.x.ai/console/billing
# 1. Sign in and select the team that owns your API key.
# 2. Open Billing > API spend management and purchase credits for that team.
# 3. Enter the amount, complete payment, and check the available credit balance.
# Default model: grok-4.3. Image model: a Responses model with the image_generation tool.
# Verified image model: grok-4.7 (2026-10-30).
GENT_TEST_XAI_KEY=
GENT_TEST_XAI_MODEL=
GENT_TEST_XAI_IMAGE_MODEL=
GENT_TEST_XAI_URL=

# DeepSeek: https://platform.deepseek.com/ (API keys and Top up)
# Balance: https://platform.deepseek.com/balance
# 1. Sign in to the DeepSeek API platform and open the balance page.
# 2. Select Top up, choose the amount and payment method, and complete payment.
# 3. Check the available balance, then create an API key in the same account.
# Default model: deepseek-flash
GENT_TEST_DEEPSEEK_KEY=
GENT_TEST_DEEPSEEK_MODEL=
GENT_TEST_DEEPSEEK_URL=

# OpenRouter: https://openrouter.ai/keys
# Buy credits: https://openrouter.ai/settings/credits
# 1. Sign in and open the credits link for the account or workspace that owns your key.
# 2. Choose a credit amount and complete payment.
# 3. Check the available balance, then create a key for that funded account or workspace.
# MODEL is required. Choose a model and route with native tools and JSON schema output.
# IMAGE_MODEL must select a model with image output, separate from the text model if needed.
GENT_TEST_OPENROUTER_KEY=
GENT_TEST_OPENROUTER_MODEL=
GENT_TEST_OPENROUTER_IMAGE_MODEL=
GENT_TEST_OPENROUTER_URL=

# Local runtimes: no provider top-up. URL and MODEL are required; KEY is optional server auth.
# Start each actual runtime with a model, native tools, and a compatible JSON schema backend.
# Supply the model ID served by that endpoint. Leave the whole block empty until it is ready.

# vLLM. Example URL: http://localhost:8000/v1
GENT_TEST_VLLM_URL=
GENT_TEST_VLLM_MODEL=
GENT_TEST_VLLM_KEY=

# Ollama local API. Example URL: http://localhost:11434 (no /api or /v1 suffix)
# Use a local model with tools and structured output; this is not the Ollama cloud test.
GENT_TEST_OLLAMA_URL=
GENT_TEST_OLLAMA_MODEL=
GENT_TEST_OLLAMA_KEY=

# llama.cpp. Example URL: http://localhost:8080/v1 (use your server's actual port)
GENT_TEST_LLAMACPP_URL=
GENT_TEST_LLAMACPP_MODEL=
GENT_TEST_LLAMACPP_KEY=

# SGLang. Example URL: http://localhost:30000/v1
GENT_TEST_SGLANG_URL=
GENT_TEST_SGLANG_MODEL=
GENT_TEST_SGLANG_KEY=
