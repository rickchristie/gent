{
  "editor.rulers": [100],
  "go.toolsEnvVars": {
    "CGO_LDFLAGS": "-L${env:HOME}/.gent/lib",
    "LD_LIBRARY_PATH": "${env:HOME}/.gent/lib"
  },
  "go.testEnvFile": "${workspaceFolder}/.env",
  "go.testFlags": ["-v", "-count=1"],
  "go.testTimeout": "15m",
  "terminal.integrated.profiles.linux": {
    "bash-env": {
      "path": "bash",
      "args": ["--rcfile", "${workspaceFolder}/.vscode/bashrc"]
    }
  },
  "terminal.integrated.defaultProfile.linux": "bash-env"
}
