{
  "version": "2.0.0",
  "options": {
    "env": {
      "CGO_LDFLAGS": "-L${env:HOME}/.gent/lib",
      "LD_LIBRARY_PATH": "${env:HOME}/.gent/lib:${env:LD_LIBRARY_PATH}"
    }
  },
  "tasks": [
    {
      "label": "Test: gowt All Packages",
      "type": "shell",
      "command": "set -a && source .env && set +a && go clean -testcache && gowt ./...",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "Test: CLI Streaming",
      "type": "shell",
      "command": "set -a && source ${workspaceFolder}/.env && set +a && go run ./models/clistreamtest",
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Test: CLI Integration",
      "type": "shell",
      "command": "set -a && source ${workspaceFolder}/.env && set +a && go run ./integrationtest/cli",
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Gent: Setup ONNX",
      "type": "shell",
      "command": "go run ./cmd/gent setup onnx",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Gent: Model List",
      "type": "shell",
      "command": "go run ./cmd/gent model list",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Gent: Model Download",
      "type": "shell",
      "command": "go run ./cmd/gent model download ${input:modelName}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Clean: Transient Files",
      "type": "shell",
      "command": "rm -rf .logs/ cli clistreamtest cliairlinetest && echo 'Cleaned transient files.'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "modelName",
      "type": "pickString",
      "description": "Select embedding model to download",
      "options": [
        "multilingual-e5-small",
        "multilingual-e5-base",
        "e5-small-v2",
        "all-MiniLM-L6-v2",
        "bge-small-en-v1.5",
        "bge-base-en-v1.5",
        "nomic-embed-text-v1.5",
        "snowflake-arctic-embed-s",
        "snowflake-arctic-embed-m",
        "bge-micro-v2"
      ],
      "default": "multilingual-e5-small"
    }
  ]
}
