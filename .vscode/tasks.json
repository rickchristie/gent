{
  "version": "2.0.0",
  "options": {
    "env": {
      "CGO_LDFLAGS": "-L${env:HOME}/.gent/lib",
      "LD_LIBRARY_PATH": "${env:HOME}/.gent/lib:${env:LD_LIBRARY_PATH}"
    }
  },
  "tasks": [
    {
      "label": "Test: gowt All Packages",
      "type": "shell",
      "command": "set -a && source .env && set +a && go clean -testcache && gowt ./...",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "Test: gowt Smoke API Calls",
      "type": "shell",
      "command": "set -a && source .env && set +a && export GENT_SMOKE_TEST=1 && gowt -run TestSmokeAllProviders ./models/",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "Test: CLI Streaming",
      "type": "shell",
      "command": "set -a && source ${workspaceFolder}/.env && set +a && go run ./models/clistreamtest",
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Test: CLI Integration",
      "type": "shell",
      "command": "set -a && source ${workspaceFolder}/.env && set +a && go run ./integrationtest/cli",
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Gent: Setup ONNX",
      "type": "shell",
      "command": "go run ./cmd/gent setup onnx",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Gent: Model List",
      "type": "shell",
      "command": "go run ./cmd/gent model list",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Gent: Model Download",
      "type": "shell",
      "command": "go run ./cmd/gent model download ${input:modelName}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Clean: Transient Files",
      "type": "shell",
      "command": "rm -rf .logs/ cli clistreamtest cliairlinetest && echo 'Cleaned transient files.'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "AI: Build Proxy",
      "type": "shell",
      "command": "${workspaceFolder}/.sandb/proxy/build.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "clear": false,
        "echo": true,
        "focus": false,
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "isBackground": false
    },
    {
      "label": "AI: Start Proxy",
      "type": "shell",
      "command": "${workspaceFolder}/.sandb/proxy/start.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "clear": false,
        "close": true,
        "echo": true,
        "focus": false,
        "panel": "dedicated",
        "reveal": "silent",
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "isBackground": false
    },
    {
      "label": "AI: Build CLI",
      "type": "shell",
      "command": "${workspaceFolder}/.sandb/cli/build.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "clear": false,
        "echo": true,
        "focus": false,
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "isBackground": false
    },
    {
      "label": "AI: Shell",
      "type": "shell",
      "command": "${workspaceFolder}/.sandb/shell.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": true,
        "panel": "new",
        "group": "ai-shell",
        "close": true,
        "reveal": "always",
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 99,
        "reevaluateOnRerun": true
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "AI: Doctor",
      "type": "shell",
      "command": "${workspaceFolder}/.sandb/shell.sh -c '${workspaceFolder}/.sandb/doctor.sh'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": true,
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "isBackground": false
    }
  ],
  "inputs": [
    {
      "id": "modelName",
      "type": "pickString",
      "description": "Select embedding model to download",
      "options": [
        "multilingual-e5-small",
        "multilingual-e5-base",
        "e5-small-v2",
        "all-MiniLM-L6-v2",
        "bge-small-en-v1.5",
        "bge-base-en-v1.5",
        "nomic-embed-text-v1.5",
        "snowflake-arctic-embed-s",
        "snowflake-arctic-embed-m",
        "bge-micro-v2"
      ],
      "default": "multilingual-e5-small"
    }
  ]
}
